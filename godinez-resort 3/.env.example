# Copy this file to .env and fill in real values before deploying publicly.
# .env is only read locally / on your host - never commit real secrets to
# a public code repository.

# A long random string used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "production" when deployed live (enables secure, HTTPS-only cookies).
# Leave unset or "development" when running on your own computer.
NODE_ENV=development

# The port your host expects the app to listen on. Most hosts (Render,
# Railway, etc.) set this automatically - you usually don't need to touch it.
PORT=3000
